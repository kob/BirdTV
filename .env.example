# ============================================================
# BirdTV 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改：cp .env.example .env
# ============================================================

# ==================== 服务器配置 ====================
# 监听地址
HOST=0.0.0.0
# 监听端口
PORT=8771
# 运行环境 (development/production)
NODE_ENV=production
# 日志级别 (error/warn/info/debug)
LOG_LEVEL=info

# ==================== 认证配置 ====================
# 是否启用认证 (true/false)
AUTH_ENABLED=true
# JWT 密钥（生产环境必须修改为随机字符串，可用 openssl rand -hex 32 生成）
AUTH_JWT_SECRET=change-me-in-production
# Token 有效期（天）
AUTH_TOKEN_EXPIRE_DAYS=7
# 默认管理员用户名（首次启动时自动创建）
AUTH_DEFAULT_ADMIN=admin
# 默认管理员密码（首次登录后请立即修改）
AUTH_DEFAULT_PASSWORD=admin123
# Token 签名密钥（用于非 JWT 模式下的 Token 签名验证）
# SECRET_KEY=change-me-in-production

# ==================== Redis 配置 ====================
# Redis 用于存储认证 Token 和用户数据，不配置则使用内存存储（重启后丢失）
#
# Redis 连接
AUTH_REDIS_HOST=
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0
#
# Redis 数据隔离前缀（多实例共享同一 Redis 时必须设置不同值）
# 所有数据 key 格式为: {REDIS_DATA_PREFIX}{key}，例如 birdtv:storage:channels
REDIS_DATA_PREFIX=birdtv:storage:
#
# Redis 认证模块前缀（认证模块独立的前缀体系）
# 认证 key 格式为: {REDIS_PREFIX}:{BIRDTV_SYSTEM_ID}:auth:tokens 等
REDIS_PREFIX=birdtv
BIRDTV_SYSTEM_ID=default
#
# 服务器标识（用于日志区分，可选）
SERVER_ID=default

# ==================== 静态资源与数据目录 ====================
# 前端静态文件根目录（默认 web/）
BIRDTV_STATIC_ROOT=./web
# 数据存储目录（JSON 文件存储位置）
BIRDTV_DATA_DIR=./data
# 缓存文件目录
BIRDTV_CACHE_ROOT=./files/cache

# ==================== M3U 代理配置 ====================
# 代理请求超时时间（毫秒）
BIRDTV_TIMEOUT_MS=40000
# 最大重定向跟随次数
BIRDTV_REDIRECT_LIMIT=3
# 默认 User-Agent（代理请求时使用）
BIRDTV_DEFAULT_UA=okhttp/4.3
# 远程 M3U 源地址（可选，用于 M3U 代理转发）
BIRDTV_REMOTE_BASE_URL=

# ==================== 缓存配置 ====================
# M3U 缓存过期时间（毫秒），0 表示不缓存
BIRDTV_CACHE_M3U_TTL_MS=600000
# EPG 缓存过期时间（毫秒），0 表示不缓存
BIRDTV_CACHE_EPG_TTL_MS=3600000

# ==================== 安全配置 ====================
# 允许代理的目标主机白名单（逗号分隔，留空表示不限制）
# BIRDTV_ALLOWED_HOSTS=example.com,cdn.example.com

# ==================== 上游代理配置 ====================
# 本机访问外部源时使用的 HTTP/HTTPS 代理（留空表示不使用）
# 支持标准代理格式：http://host:port 或 http://user:pass@host:port
BIRDTV_UPSTREAM_PROXY=

# ==================== API 服务器配置 ====================
# 以下变量仅在独立运行 API 服务器时需要配置
# 通常与主服务共用同一端口，无需单独设置
# API_SERVER_PORT=8771
# API_SERVER_HOST=0.0.0.0
# CORS 允许的源（逗号分隔，留空或 * 表示允许所有）
# API_CORS_ORIGIN=*

# ==================== 兼容旧版环境变量 ====================
# 以下旧版变量名仍可使用，但推荐使用 BIRDTV_ 前缀的新变量
# M3U_PROXY_PORT        → BIRDTV_PORT
# M3U_PROXY_HOST        → BIRDTV_HOST
# M3U_PROXY_TIMEOUT_MS  → BIRDTV_TIMEOUT_MS
# M3U_PROXY_REDIRECT_LIMIT → BIRDTV_REDIRECT_LIMIT
# M3U_PROXY_DEFAULT_UA  → BIRDTV_DEFAULT_UA
# M3U_PROXY_STATIC_ROOT → BIRDTV_STATIC_ROOT
# M3U_PROXY_CACHE_ROOT  → BIRDTV_CACHE_ROOT
# M3U_PROXY_CACHE_M3U_TTL_MS → BIRDTV_CACHE_M3U_TTL_MS
# M3U_PROXY_CACHE_EPG_TTL_MS → BIRDTV_CACHE_EPG_TTL_MS
# M3U_REMOTE_BASE_URL   → BIRDTV_REMOTE_BASE_URL
# M3U_PROXY_ALLOWED_HOSTS → BIRDTV_ALLOWED_HOSTS
# M3U_PROXY_DATA_DIR    → BIRDTV_DATA_DIR
# M3U_UPSTREAM_PROXY    → BIRDTV_UPSTREAM_PROXY
# HTTPS_PROXY / HTTP_PROXY → BIRDTV_UPSTREAM_PROXY（作为兜底检测）
