# ============================================================
# BirdTV 环境变量配置
# 复制此文件为 .env 并根据实际情况修改：cp .env.example .env
# ============================================================

# ==================== 服务器配置 ====================
# 监听地址
BIRDTV_HOST=0.0.0.0
# 监听端口
BIRDTV_PORT=8771

# ==================== 认证配置 ====================
# 是否启用认证 (true/false)
AUTH_ENABLED=true
# JWT 密钥（生产环境必须修改为随机字符串，可用 openssl rand -hex 32 生成）
AUTH_JWT_SECRET=change-me-in-production
# Token 有效期（天）
AUTH_TOKEN_EXPIRE_DAYS=7
# 默认管理员用户名（首次启动时自动创建）
AUTH_DEFAULT_ADMIN=admin
# 默认管理员密码（首次登录后请立即修改）
AUTH_DEFAULT_PASSWORD=admin123

# ==================== KVRocks 配置（必填） ====================
# KVRocks 用于存储所有业务数据（频道、认证、设置等），必须配置
AUTH_REDIS_HOST=
AUTH_REDIS_PORT=6666
AUTH_REDIS_PASSWORD=

# ==================== 多实例隔离 ====================
# 不同实例设置不同的 BIRDTV_SYSTEM_ID，所有 KVRocks key 自动按前缀隔离
# 例如：server1 设置 BIRDTV_SYSTEM_ID=server1，server2 设置 BIRDTV_SYSTEM_ID=server2
BIRDTV_SYSTEM_ID=default

# KVRocks 数据存储 key 前缀（会自动附加 BIRDTV_SYSTEM_ID，无需手动区分实例）
REDIS_DATA_PREFIX=birdtv:storage:
# KVRocks 认证模块 key 前缀（会自动附加 BIRDTV_SYSTEM_ID）
REDIS_PREFIX=birdtv
# 服务器标识（仅用于日志区分）
SERVER_ID=default

# ==================== M3U 代理配置 ====================
# 远程 M3U 源地址（可选，用于 M3U 代理转发）
M3U_REMOTE_BASE_URL=
# 代理请求超时时间（毫秒）
M3U_PROXY_TIMEOUT_MS=40000
# 最大重定向跟随次数
M3U_PROXY_REDIRECT_LIMIT=3
# 默认 User-Agent（代理请求时使用）
M3U_PROXY_DEFAULT_UA=okhttp/4.3

# ==================== SSL/HTTPS 配置 ====================
# 启用 HTTPS 后，EME (Encrypted Media Extensions) 才能在非 localhost 环境下工作
# Chrome 要求加密媒体播放必须在 HTTPS 页面中运行，否则 Shaka Player 会报 Error 6020
# 默认自动生成自签名证书，也可手动指定证书路径

# SSL 私钥文件路径（留空则自动生成自签名证书）
# BIRDTV_SSL_KEY=./ssl/server-key.pem
# SSL 证书文件路径（留空则自动生成自签名证书）
# BIRDTV_SSL_CERT=./ssl/server-cert.pem
# HTTPS 监听端口（默认为 BIRDTV_PORT + 1，即 8772）
# HTTP 端口仍保留用于 301 重定向到 HTTPS
# BIRDTV_SSL_PORT=8772

# ==================== 可选高级配置 ====================
# 以下变量大多数场景无需配置，使用默认值即可

# 静态文件根目录（默认 web/）
# BIRDTV_STATIC_ROOT=./web
# 数据存储目录（JSON 文件存储位置）
# BIRDTV_DATA_DIR=./data
# 缓存文件目录
# BIRDTV_CACHE_ROOT=./files/cache
# M3U 缓存过期时间（毫秒），0 表示不缓存
# BIRDTV_CACHE_M3U_TTL_MS=600000
# EPG 缓存过期时间（毫秒），0 表示不缓存
# BIRDTV_CACHE_EPG_TTL_MS=3600000
# 允许代理的目标主机白名单（逗号分隔，留空表示不限制）
# BIRDTV_ALLOWED_HOSTS=example.com,cdn.example.com

# Cloudflare Worker 代理地址（用于绕过 WAF 拦截导致的 403/520 错误，留空则禁用）
# 注意：CF Worker → CF 站点时会注入 Cdn-Loop 头，若目标站 WAF 基于此拦截，请改用 DENO_PROXY
# CLOUDFLARE_WORKER_URL=

# Cloudflare Worker 代理域名列表（逗号分隔，匹配的域名请求直接走 Worker 代理，而非先直连再重试）
# 支持：精确匹配（example.com）和后缀匹配（.example.com 匹配所有子域名）
# CLOUDFLARE_WORKER_DOMAINS=.example.com

# Deno Deploy 代理地址（用于绕过 CF 同生态 WAF 拦截，如 ASN 限制导致的 403 错误，留空则禁用）
# 部署方式：将 deno-proxy.js 部署到 https://dash.deno.com，然后将 URL 填入下方
# DENO_PROXY_URL=

# Deno Deploy 代理域名列表（逗号分隔，匹配的域名走 Deno 代理而非 CF Worker，优先级高于 CLOUDFLARE_WORKER_DOMAINS）
# 适用于 CF Worker 无法代理的 CF 站点（因 Cdn-Loop 头被 WAF 拦截）
# DENO_PROXY_DOMAINS=.touch-u.fun

# 阿里云 ESA（边缘安全加速）代理地址（用于国内源加速或绕过国内 CDN WAF 拦截，留空则禁用）
# 部署方式：将 esa-proxy.js 部署到阿里云 ESA 边缘函数或 Pages，然后将 URL 填入下方
# ESA 代理优先级最高（国内节点延迟最低），高于 Deno 和 CF Worker
# ESA_PROXY_URL=

# 阿里云 ESA 代理域名列表（逗号分隔，匹配的域名走 ESA 代理，优先级最高）
# 适用于国内 CDN 站点或需要国内边缘节点加速的场景
# ESA_PROXY_DOMAINS=.example.cn,.some-cdn.com

# 本机访问外部源时使用的 HTTP/HTTPS 代理（留空表示不使用）
# BIRDTV_UPSTREAM_PROXY=
# 系统标准代理变量（作为兜底检测）
# HTTPS_PROXY=
# HTTP_PROXY=
