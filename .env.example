# BirdTV 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ========== 服务器配置 ==========
# 服务器监听地址
HOST=0.0.0.0
# 服务器端口
PORT=8771

# ========== 认证配置 ==========
# 是否启用认证 (true/false)
AUTH_ENABLED=true
# JWT 密钥（生产环境必须修改为随机字符串）
AUTH_JWT_SECRET=请修改为随机密钥 - 生产环境必须修改
# Token 有效期（天）
AUTH_TOKEN_EXPIRE_DAYS=7
# 默认管理员用户名
AUTH_DEFAULT_ADMIN=admin
# 默认管理员密码（生产环境必须修改）
AUTH_DEFAULT_PASSWORD=admin123

# ========== Redis 配置（可选，默认不启用）==========
# 如需启用 Redis，请取消以下配置的注释
# AUTH_REDIS_HOST=localhost
# AUTH_REDIS_PORT=6379
# AUTH_REDIS_PASSWORD=
# AUTH_REDIS_DB=0
# 不配置 Redis 时，系统会自动使用内存存储（重启后数据会丢失）

# ========== 代理配置 ==========
# 远程 M3U 源地址（可选）
M3U_REMOTE_BASE_URL=https://example.com/playlist.m3u
# 代理超时设置（毫秒）
M3U_PROXY_TIMEOUT_MS=40000
# 最大重定向次数
M3U_PROXY_REDIRECT_LIMIT=3
# 默认 User-Agent
M3U_PROXY_DEFAULT_UA=okhttp/4.3

# ========== BirdTV 配置（可选）==========
# 默认 User-Agent（优先级高于 M3U_PROXY_DEFAULT_UA）
BIRDTV_DEFAULT_UA=okhttp/4.3
# 数据目录
BIRDTV_DATA_DIR=./data

# ========== 运行环境 ==========
# 运行环境 (development/production)
NODE_ENV=development
# 日志级别 (error/warn/info/debug)
LOG_LEVEL=info
