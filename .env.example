# ============================================================
# BirdTV 环境变量配置
# 复制此文件为 .env 并根据实际情况修改：cp .env.example .env
# ============================================================

# ==================== 服务器配置 ====================
# 监听地址
BIRDTV_HOST=0.0.0.0
# 监听端口
BIRDTV_PORT=8771

# ==================== 认证配置 ====================
# 是否启用认证 (true/false)
AUTH_ENABLED=true
# JWT 密钥（生产环境必须修改为随机字符串，可用 openssl rand -hex 32 生成）
AUTH_JWT_SECRET=change-me-in-production
# Token 有效期（天）
AUTH_TOKEN_EXPIRE_DAYS=7
# 默认管理员用户名（首次启动时自动创建）
AUTH_DEFAULT_ADMIN=admin
# 默认管理员密码（首次登录后请立即修改）
AUTH_DEFAULT_PASSWORD=admin123

# ==================== KVRocks 配置（必填） ====================
# KVRocks 用于存储所有业务数据（频道、认证、设置等），必须配置
AUTH_REDIS_HOST=
AUTH_REDIS_PORT=6666
AUTH_REDIS_PASSWORD=

# ==================== 多实例隔离 ====================
# 不同实例设置不同的 BIRDTV_SYSTEM_ID，所有 KVRocks key 自动按前缀隔离
# 例如：server1 设置 BIRDTV_SYSTEM_ID=server1，server2 设置 BIRDTV_SYSTEM_ID=server2
BIRDTV_SYSTEM_ID=default

# KVRocks 数据存储 key 前缀（会自动附加 BIRDTV_SYSTEM_ID，无需手动区分实例）
REDIS_DATA_PREFIX=birdtv:storage:
# KVRocks 认证模块 key 前缀（会自动附加 BIRDTV_SYSTEM_ID）
REDIS_PREFIX=birdtv
# 服务器标识（仅用于日志区分）
SERVER_ID=default

# ==================== M3U 代理配置 ====================
# 远程 M3U 源地址（可选，用于 M3U 代理转发）
M3U_REMOTE_BASE_URL=
# 代理请求超时时间（毫秒）
M3U_PROXY_TIMEOUT_MS=40000
# 最大重定向跟随次数
M3U_PROXY_REDIRECT_LIMIT=3
# 默认 User-Agent（代理请求时使用）
M3U_PROXY_DEFAULT_UA=okhttp/4.3

# ==================== 可选高级配置 ====================
# 以下变量大多数场景无需配置，使用默认值即可

# 静态文件根目录（前后端分离模式：web-vue/dist/）
# BIRDTV_STATIC_ROOT=./web-vue/dist
# 数据存储目录（JSON 文件存储位置）
# BIRDTV_DATA_DIR=./data
# 缓存文件目录
# BIRDTV_CACHE_ROOT=./files/cache
# M3U 缓存过期时间（毫秒），0 表示不缓存
# BIRDTV_CACHE_M3U_TTL_MS=600000
# EPG 缓存过期时间（毫秒），0 表示不缓存
# BIRDTV_CACHE_EPG_TTL_MS=3600000
# 允许代理的目标主机白名单（逗号分隔，留空表示不限制）
# BIRDTV_ALLOWED_HOSTS=example.com,cdn.example.com

# Cloudflare Worker 代理地址（用于绕过 WAF 拦截导致的 403/520 错误，留空则禁用）
# CLOUDFLARE_WORKER_URL=

# 本机访问外部源时使用的 HTTP/HTTPS 代理（留空表示不使用）
# BIRDTV_UPSTREAM_PROXY=
# 系统标准代理变量（作为兜底检测）
# HTTPS_PROXY=
# HTTP_PROXY=
