[Unit]
Description=BirdTV IPTV Proxy Service
Documentation=https://github.com/your-repo/birdtv
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/workspace/BirdTV

# 环境变量（KVRocks 连接为必填项）
Environment="PORT=8771"
# Environment="AUTH_REDIS_HOST=localhost"
# Environment="AUTH_REDIS_PORT=6666"

# 启动命令
ExecStart=/usr/bin/node /workspace/BirdTV/birdtv.js

# 自动重启配置
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# 标准输出和错误
StandardOutput=append:/workspace/BirdTV/birdtv.log
StandardError=append:/workspace/BirdTV/birdtv.log

# 文件描述符限制
LimitNOFILE=65536

# 进程管理
PIDFile=/workspace/BirdTV/birdtv.pid

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

# 超时设置
TimeoutStopSec=30
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
